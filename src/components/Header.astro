---
// Cabecera «tajo»: losa de tinta (color primario) fija arriba, a todo el ancho y siempre sólida. Nombre en Oswald
// mayúscula (o el logo), enlaces con subrayado naranja al pasar, teléfono en cifras (pantallas anchas) y el botón
// naranja de `boton_cabecera`. En móvil: botón cuadrado para llamar y menú plegable con <details>.
// Va por encima de la portada (z-index 50). Aspecto: .cabecera--tajo en src/styles/global.css.
import { site, tel } from '../data/site';
import type { Enlace } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'tajo', cta = null } = Astro.props;
const telefono = site.contacto.telefono;
---

<header class={`cabecera cabecera--${variante}`}>
  <div class="contenedor cabecera-fila">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      {
        site.logo ? (
          <img src={site.logo} alt={site.nombre} class="marca-logo" width="160" height="40" />
        ) : (
          <span class="marca-nombre">{site.nombre}</span>
        )
      }
    </a>
    <nav class="cabecera-nav" aria-label="Menú principal">
      {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
    </nav>
    {
      telefono && (
        <a href={tel(telefono)} class="cabecera-telefono" aria-label={`Llamar al ${telefono}`}>
          <Icono nombre="telefono" tam={18} />
          <span>{telefono}</span>
        </a>
      )
    }
    {cta && cta.url && <a href={cta.url} class="btn cabecera-cta">{cta.texto}</a>}
    {
      telefono && (
        <a href={tel(telefono)} class="cabecera-llamar" aria-label={`Llamar al ${telefono}`}>
          <Icono nombre="telefono" tam={20} />
        </a>
      )
    }
    {
      site.menu.length > 0 && (
        <details class="menu-movil">
          <summary>
            <span class="menu-movil-icono" aria-hidden="true" />
            <span>Menú</span>
          </summary>
          <nav class="menu-movil-panel" aria-label="Menú">
            {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
            {cta && cta.url && <a href={cta.url} class="btn">{cta.texto}</a>}
          </nav>
        </details>
      )
    }
  </div>
</header>
<script is:inline>
  document.querySelectorAll('.menu-movil a').forEach(function (a) {
    a.addEventListener('click', function () { a.closest('details').open = false; });
  });
</script>
