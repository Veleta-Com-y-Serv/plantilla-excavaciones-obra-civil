---
// Ficha de un servicio o de una máquina con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts):
// /servicios/<slug>/ y /maquinaria/<slug>/. Misma piel que la portada: banda de hormigón más oscuro con migas y el
// titular en Oswald (ajustado a su palabra más larga), su línea, el precio en cifras y los botones; a la derecha la foto
// en blanco y negro con marco de tinta (sin foto, el texto ocupa la fila). Debajo, el `detalle` en párrafos y, al lado,
// los datos entre filetes y una placa para pedir presupuesto; las fotos de `imagenes`; y otros elementos de la lista.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Titular from '../../components/ui/Titular.astro';
import { site, tel, whatsapp, largo } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Pedir presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const etiquetas: Record<string, string> = { capacidad: 'Capacidad', uso: 'Para', categoria: 'Tipo', lugar: 'Lugar', anio: 'Año' };
const datos = f.datos.filter((d) => d.clave !== 'precio').map((d) => ({ ...d, etiqueta: etiquetas[d.clave] ?? d.etiqueta }));
const categoria = f.datos.find((d) => d.clave === 'categoria')?.valor ?? '';
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--colada">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--foto': f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{categoria || f.def.nombre}</p>
          <h1 class="ficha-titulo" style={`--l:${largo(f.titulo)}`}>{f.titulo}</h1>
          {f.texto && <p class="entrada mt-5">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="botones">
            <a class="btn" href={contacto}>{textoContacto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
          </div>
        </div>
        {f.imagen && (
          <div class="ficha-foto foto foto--marco">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad respaldo="/placeholders/foto.svg" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--papel">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div>
            <h2>Datos</h2>
            <dl class="datos">
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="placa">
          <h2>¿Lo necesitas?</h2>
          <p class="mt-3">Cuéntanos dónde es y qué hay que hacer. Te damos el precio por escrito.</p>
          <div class="botones mt-6">
            <a class="btn" href={contacto}>{textoContacto}</a>
          </div>
          {c.telefono && <p class="mt-5"><a class="enlace cifra text-xl" href={tel(c.telefono)}>{c.telefono}</a></p>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--colada" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li class="foto foto--color foto--marco"><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} respaldo="/placeholders/foto.svg" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--papel">
      <div class="contenedor">
        <Titular cabeza antetitulo={nombreSeccion} titulo={f.def.ruta === 'maquinaria' ? 'Más máquinas' : 'Más servicios'} />
        <ul class="indice">
          {otras.map((o) => (
            <li>
              <h3><a href={o.url}>{o.titulo}</a></h3>
              {o.texto ? <p class="indice-texto">{o.texto}</p> : <span />}
              {o.precio ? <p class="cifra indice-ver">{o.precio}</p> : <span />}
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Volver a {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>
